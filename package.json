{
  "name": "@piiix/omp-peers",
  "version": "0.1.0",
  "description": "Local peer-session messaging, master control, and model routing for OMP.",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/PIIIX-org/omp-peers.git"
  },
  "homepage": "https://github.com/PIIIX-org/omp-peers#readme",
  "bugs": "https://github.com/PIIIX-org/omp-peers/issues",
  "keywords": ["omp", "omp-extension", "omp-plugin", "peers", "multi-agent"],
  "files": ["extensions", "lib", "tools", "docs", "README.md", "LICENSE-MIT", "LICENSE-APACHE"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint extensions/*.ts lib/*.ts tests/*.ts",
    "test:watcher": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:smoke": "python3 tests/smoke.py",
    "test:activity": "bun test tests/activity.test.ts",
    "test:reports": "bun test tests/reports.test.ts",
    "test:activity-smoke": "python3 tests/activity_smoke.py",
    "scan": "python3 scripts/leak_scan.py"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-natives": ">=18.18.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@oh-my-pi/pi-coding-agent": "18.18.1",
    "@types/bun": "1.4.4",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "omp": {
    "extensions": ["./extensions/peers.ts"]
  }
}
